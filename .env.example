ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional — Kimi via Moonshot (no league tool loop; base context only)
# MOONSHOT_API_KEY=your-moonshot-api-key
# Optional — advisor web_search tool (injury/roster news via Brave Search API)
# BRAVE_API_KEY=your-brave-search-api-key
DATABASE_URL=postgresql+psycopg://blackbook:blackbook@localhost:5444/blackbook
SLEEPER_USERNAME=alefautsch
# Comma-separated frontend origins. Include 127.0.0.1 if you open the app that way.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Railway web service also needs API_URL for server components.
# API_URL=http://api.railway.internal:8000

# In-process API scheduler (§9.1). Cron is UTC; API uses a Postgres advisory lock.
SYNC_CRON=0 6 * * *
SYNC_ENABLED=true
# Optional gate for POST /admin/recompute-history
# ADMIN_TOKEN=change-me

# Top-N unrostered players scored per league at sync for FA board (§14.2)
# FA_POOL_SIZE=150

FROM python:3.13-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY dynasty_draft ./dynasty_draft
COPY backend ./backend
COPY alembic ./alembic
COPY alembic.ini ./
COPY war.csv ./
COPY leagues.seed.json ./
COPY config.example.json ./
COPY scripts/start-blackbook-api.sh ./scripts/start-blackbook-api.sh

RUN chmod +x ./scripts/start-blackbook-api.sh && uv sync --frozen

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["./scripts/start-blackbook-api.sh"]
